{
  "name": "citadail",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "postinstall": "npm --prefix frontend ci --include=dev",
    "build": "npm --prefix frontend run build",
    "start": "npm --prefix frontend run start -- -H 0.0.0.0 -p ${PORT:-3000}",
    "dev": "npm --prefix frontend run dev",
    "lint": "npm --prefix frontend run lint",
    "test:shell": "npm --prefix frontend run test:shell",
    "spectrum:agent": "npm --prefix frontend run spectrum:agent"
  }
}
