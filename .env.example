# Citadail local environment template
#
# Copy this file to frontend/.env.local for local development:
#   cp .env.example frontend/.env.local
#
# Never commit real secrets.

# AI generation and assistant features
GEMINI_API_KEY=
GEMINI_EQUITY_PROJECT_MODEL=gemini-2.5-flash
GEMINI_EQUITY_PROJECT_TIMEOUT_MS=20000
GEMINI_EQUITY_SEARCH_MODEL=gemini-2.5-flash
GEMINI_SEARCH_TIMEOUT_MS=10000
GEMINI_SIDEBAR_CHAT_MODEL=
GEMINI_SIDEBAR_CHAT_TIMEOUT_MS=18000
NEXT_PUBLIC_GEMINI_LIVE_MODEL=

# Equity source behavior
SEC_USER_AGENT=Citadail research contact@example.com
EQUITY_ENABLE_GEMINI_SEARCH=true
EQUITY_PREFER_CACHED_RESEARCH=true
EQUITY_USE_GEMINI_FOR_CACHED_RESEARCH=false
FINNHUB_API_KEY=
PERPLEXITY_API_KEY=

# App/runtime URLs
CITADAIL_APP_URL=http://localhost:3000
CITADAIL_BASE_URL=http://127.0.0.1:3000
NEXT_PUBLIC_GITHUB_PAGES=false

# Spectrum / iMessage command layer
SPECTRUM_USE_TERMINAL=true
PHOTON_PROJECT_ID=
PHOTON_PROJECT_SECRET=
CITADAIL_ALLOWED_SENDERS=
CITADAIL_ALLOWED_SPACES=
CITADAIL_PROACTIVE_INTERVAL_MS=12000
CITADAIL_SPECTRUM_STATE_PATH=

# Dedalus / OpenClaw runtime proof
DEDALUS_API_KEY=
DEDALUS_MACHINE_ID=
DEDALUS_DCS_BASE_URL=https://dcs.dedaluslabs.ai
DEDALUS_API_BASE_URL=https://api.dedaluslabs.ai
DEDALUS_MODEL=openai/gpt-5
DEDALUS_MACHINE_AUTOCREATE=false
CITADAIL_DEDALUS_STATE_PATH=

# Local browser/test overrides
CITADAIL_PLAYWRIGHT_EXECUTABLE=
